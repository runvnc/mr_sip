# ============================================
# MindRoot SIP Plugin - S2S Mode Configuration
# ============================================
# Copy this file to .env and fill in your credentials

# ============================================
# Mode Selection
# ============================================
SIP_PROVIDER=s2s

# ============================================
# SIP Configuration
# ============================================
SIP_GATEWAY=your.sip.gateway.com
SIP_USER=your_sip_username
SIP_PASSWORD=your_sip_password

# Audio capture method (must be jack for S2S)
AUDIO_CAPTURE_METHOD=jack

# Call establishment timeout in seconds
SIP_CALL_ESTABLISH_TIMEOUT=120

# Audio directory for recordings (optional)
AUDIO_DIR=.

# ============================================
# OpenAI Realtime API Configuration
# ============================================
OPENAI_API_KEY=sk-...

# Model for realtime API
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-10-01

# Voice selection: alloy, echo, fable, onyx, nova, shimmer
OPENAI_VOICE=alloy

# ============================================
# JACK Audio Configuration (Optional)
# ============================================
# Enable verbose JACK logging
BARESIP_JACK_V=0

# ============================================
# Logging (Optional)
# ============================================
# Set to DEBUG for more verbose logging
LOG_LEVEL=INFO
